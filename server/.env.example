DATABASE_URL=mongodb://127.0.0.1:27017/peer_share
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Development account email: docker compose up -d mailpit
# Local inbox: http://localhost:8025 (do not expose publicly).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Peer Share <noreply@localhost>

# Only for a deliberate public test preview. Leave blank for normal local work.
PUBLIC_APP_URL=

# Server-issued, one-hour coturn TURN REST credentials.
# Keep TURN_SHARED_SECRET on the server and use the same value in coturn.
STUN_URLS=
TURN_URLS=
TURN_SHARED_SECRET=
ICE_RELAY_ONLY=false

# Local TURN testing:
# docker compose --env-file server/.env -f compose.yaml -f compose.turn.yaml up -d turn
# STUN_URLS=stun:127.0.0.1:3478
# TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
# A public relay needs its own reachable hostname, public relay ports and TLS.
# Hosted server (Render Blueprint sets these; local defaults stay unchanged).
# Render supplies RENDER_EXTERNAL_URL automatically as the auth URL fallback.
# For a custom domain set BETTER_AUTH_URL to that HTTPS origin instead.
HOST=127.0.0.1
PORT=3000
SERVE_CLIENT=false
# Trust only a known reverse proxy. Keep 0 when running directly/local.
TRUST_PROXY_HOPS=0
# Render Free blocks SMTP ports 25/465/587. Brevo supports STARTTLS on 2525.
# Set SMTP_HOST, SMTP_PORT=2525, SMTP_USER, SMTP_PASSWORD and MAIL_FROM
# in Render's private environment settings, not this repository.
# Explicit site-only preview: false blocks signup/recovery until email is ready.
ACCOUNT_EMAIL_ENABLED=true
